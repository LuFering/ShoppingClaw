# ShoppingClaw 环境配置模板
# 复制此文件为 .env 并填写实际值
#
# 使用方法:
#   cp .env.template .env
#   # 编辑 .env 文件,填写必要的配置

# ============================================================================
# region 基础配置
# ============================================================================

# 模型存储目录(本地开发时使用)
MODEL_DIR=./models

# HuggingFace 模型缓存目录(Docker 容器内使用 /root/.cache/huggingface)
# 本地 Windows 开发可设置为: C:\Users\你的用户名\.cache\huggingface\hub
TRANSFORMERS_CACHE=/root/.cache/huggingface

# 保存目录(对话历史、Agent 状态等)
SAVE_DIR=./saves

# Redis 连接地址(Docker 容器内使用 redis://redis:6379/0)
REDIS_URL=redis://redis:6379/0

# LangGraph Checkpointer 后端类型(postgres/memory)
LANGGRAPH_CHECKPOINTER_BACKEND=postgres

# Vite 前端配置(暂未使用)
VITE_USE_RUNS_API=false
# ============================================================================
# region 数据库配置
# ============================================================================

# PostgreSQL 连接配置(Docker Compose 会自动注入,无需手动配置)
# 以下变量仅在自定义数据库地址时需要修改
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shoppingclaw

# 完整的 PostgreSQL 连接字符串(可选,默认由上面的变量自动构建)
# POSTGRES_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/shoppingclaw

# 时区设置
TZ=Asia/Shanghai

# ============================================================================
# region 模型提供商配置
# ============================================================================

# --- Ollama 本地模型服务(推荐) ---
# Docker 容器内使用 host.docker.internal 访问宿主机
# 本地开发可使用 http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 注意: 确保 Ollama 已启动并拉取了所需模型
#   ollama serve
#   ollama pull qwen2.5:3b

# --- 硅基流动(SiliconFlow) - 免费额度 ---
# 注册地址: https://cloud.siliconflow.cn/i/Eo5yTHGJ
SILICONFLOW_API_KEY=

# --- Tavily 搜索服务(可选) ---
# 注册地址: https://app.tavily.com/
TAVILY_API_KEY=

# --- 其他可选的模型提供商 ---
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# ZHIPUAI_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# ARK_API_KEY=
# TOGETHER_API_KEY=

# --- 知识库 (RAG / LlamaIndex) ---
# Embedding 后端: dashscope (默认) 或 openai(OpenAI 兼容协议指向 DashScope)
# KNOWLEDGE_EMBED_BACKEND=dashscope
# 知识文档目录(默认 docs/knowledge)
# KNOWLEDGE_DOCS_DIR=docs/knowledge

# ============================================================================
# region 安全配置
# ============================================================================

# JWT 密钥(用于用户认证,生产环境请修改为随机字符串)
JWT_SECRET_KEY=shoppingclaw_secure_key

# URL 白名单(逗号分隔,为空则禁用 URL 解析)
# YUXI_URL_WHITELIST=github.com,docs.example.com,gitlab.example.com,127.0.0.1

# ============================================================================
# region 高级配置(可选)
# ============================================================================

# --- MinerU 文档解析服务 ---
# MINERU_API_KEY=

# --- LightRag LLM 并发限制 ---
# MAX_ASYNC=5
# EMBEDDING_FUNC_MAX_ASYNC=8

# --- Neo4j 图数据库(暂未使用) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password

# --- LangSmith 追踪(调试用) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=shoppingclaw

# ============================================================================
# endregion
# ============================================================================
