# 环境变量和密钥
.env
.env.*
*.env
*.bak
*.key
*.secret
*.pem

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
*.so

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# 项目特定
shoppingclaw.tar.gz
dist/
build/
*.log

# 依赖与缓存
node_modules/
.venv/

# 模板文件例外：.env.* 被忽略，但 .env.template 需要入库
!.env.template

# 容器运行时数据（数据库文件，严禁入库）
docker/volumes/

# 构建元数据（pip install -e 产物）
*.egg-info/

# 运行时数据出库：saves/ 由 docker compose 挂载、容器持续写入，
# 不再跟踪 users.json / chroma.sqlite3 等运行时文件（仅保留目录占位）
saves/*
!saves/.gitkeep
